{
  "_schema": "police_thief_sensitivity_design_v1",
  "status": "PREDECLARED_BEFORE_FIRST_RUN",
  "operation_class": "LOCAL_SIMULATOR_EXPERIMENT",
  "research_question": "How do existing board-size and survival-threshold parameters affect capture outcomes for the frozen champion and a direct scent baseline against two existing observation-only Thief policies?",
  "method": {
    "name": "paired_one_factor_at_a_time_screening",
    "baseline": "board_7_survival_35",
    "paired_dimensions": [
      "seed",
      "scenario",
      "police_policy",
      "thief_policy"
    ],
    "global_sensitivity_claimed": false
  },
  "hypotheses": [
    "Increasing board_size while holding survival_threshold fixed may reduce capture rate.",
    "Increasing survival_threshold while holding board_size fixed may increase capture rate.",
    "ScentTacticalPolice may be more robust than ScentGreedyPolice across the predeclared settings."
  ],
  "fixed_parameters": {
    "barrier_quota": 14,
    "barrier_placement_mode": "adjacent_only",
    "scent_profile": "subtractive_chebyshev_v1",
    "turn_model": "reference_v3_alternating",
    "start_validation_profile": "interop",
    "blocked_cells": []
  },
  "factors": {
    "board_size": [7, 9, 11],
    "survival_threshold": [35, 50, 70]
  },
  "settings": [
    {
      "id": "board_7_survival_35",
